[Unit]
Description=probe: renew the certificate of the service's key when it is due (the host key certifies it)
Documentation=file:///usr/local/share/doc/probe/RUNBOOK-stage1-linux.md

[Service]
Type=oneshot
User=root
# Does nothing while more than 10 of the 30 days remain; renews otherwise, or at once when there is no
# certificate or the key changed. It reads /etc/probe.json (or takes the defaults). A failed renewal ends
# non-zero: this unit shows as failed, and the timer tries again the next day.
ExecStart=/usr/local/bin/probe setup --if-due
# No sandboxing lines on purpose (they need mount namespaces: an unprivileged LXC container needs
# nesting for them); probe-setup-hardening.conf is the optional drop-in.
